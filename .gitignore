# --- Per-machine secrets / local config ---
.env

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# --- HuggingFace cache (multi-GB; downloads once per machine) ---
hf_cache/

# --- Training artifacts ---
# Saved LoRA adapters are ~45 MB each — not source, keep them out.
logs/*/
logs/.training_active
# ...but commit the small metric CSVs that README/report.md reference...
!logs/*.csv
# ...and the generated academic analysis figures/tables.
!logs/analysis/

# --- Container image tarball (6.8 GB) ---
hetero-demo.tar

# --- Session transcripts (may embed .env values) ---
conversations/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
